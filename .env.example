# Domain, die auf den Server zeigt (A-Record) – Caddy holt automatisch ein TLS-Zertifikat
DOMAIN=mcp.example.de

# web.de Zugangsdaten (IMAP/POP3 muss im web.de-Postfach aktiviert sein)
WEBDE_USER=dein.name@web.de
WEBDE_PASSWORD=
FROM_NAME=

# Bearer-Token für den MCP-Zugriff: openssl rand -hex 32
MCP_AUTH_TOKEN=

# false = Tool send_email wird nicht angeboten (nur lesen + Entwürfe)
ALLOW_SEND=true

# Optional (Defaults für web.de)
# IMAP_HOST=imap.web.de
# IMAP_PORT=993
# SMTP_HOST=smtp.web.de
# SMTP_PORT=587

# --- Nur wenn schon ein Reverse-Proxy (z.B. n8n-Caddy) auf 80/443 läuft ---
# PROXY_NETWORK=n8n_default
# COMPOSE_FILE=docker-compose.yml:docker-compose.shared-proxy.yml

# --- Google Drive: Anhänge einsortieren (siehe README → "Google Drive") ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=
# DRIVE_ROOT_FOLDER=Mail-Anhänge
# BUSINESS_NAME=Automationsexperten
# Merkmale, an denen geschäftliche Rechnungen erkannt werden (Firmenname, Adresse, USt-IdNr. ...)
# BUSINESS_HINTS=
